#: ui/main.qml:36
#, kde-format
msgctxt "@title:tab"
msgid "Task Switcher"
msgstr "Превключване на задачи"

#: ui/main.qml:42
#, kde-format
msgctxt "@title:tab"
msgid "Task Switcher (Alternative)"
msgstr "Превключвател на задачи (алтернативен)"

#: ui/main.qml:48
#, kde-format
msgctxt "@title:tab"
msgid "Overview"
msgstr "Преглед"

#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr ""
"Настройките на политиката за фокусиране ограничават функционалността на "
"навигацията през прозорци."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"Алтернативният превключвател на задачи е втори превключвател със собствени "
"отделни настройки за клавишна комбинация, външен вид и поведение."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Преглед:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Плъзгане нагоре с четири пръста на тъчпад или три на сензорен екран, или "
"използване на жестове по ръба на екрана за превключване на обзора"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Натискане на %1, плъзгане нагоре с четири пръста на тъчпад или три на "
"сензорен екран или използване на жестове по ръба на екрана за превключване "
"на обзора"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Натискане на %1 или %2, плъзгане нагоре с четири пръста на тъчпад или три на "
"сензорен екран или използване на жестове по ръба на екрана за превключване "
"на прегледа"

#: ui/OverviewSettings.qml:31
#, kde-format
msgctxt "@option:check, Enable overview effect"
msgid "Enable"
msgstr "Активиране"

#: ui/OverviewSettings.qml:47
#, kde-format
msgctxt "@option:check"
msgid "Show minimized windows"
msgstr "Показване на минимизирани прозорци"

#: ui/OverviewSettings.qml:63
#, kde-format
msgctxt "@option:check"
msgid "Search results include windows"
msgstr "Резултатите от търсенето включват прозорци"

#: ui/OverviewSettings.qml:77
#, kde-format
msgctxt "@option:check"
msgid "Organize windows in the Grid view"
msgstr "Организиране на прозорците в изглед „Мрежа“"

