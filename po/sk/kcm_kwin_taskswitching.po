#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr "Nastavenia politiky zamerania obmedzujú funkčnosť prechádzania oknami."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"Alternatívny prepínač úloh je druhý prepínač s vlastnou skratkou, vzhľadom a "
"správaním."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Prehľad:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Prehľad prepnete potiahnutím nahor štyrmi prstami na touchpade alebo tromi "
"na dotykovej obrazovke, alebo gestami na okraji obrazovky"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Prehľad prepnete stlačením %1, potiahnutím nahor štyrmi prstami na touchpade "
"alebo tromi na dotykovej obrazovke, alebo gestami na okraji obrazovky"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Prehľad prepnete stlačením %1 alebo %2, potiahnutím nahor štyrmi prstami na "
"touchpade alebo tromi na dotykovej obrazovke, alebo gestami na okraji "
"obrazovky"

