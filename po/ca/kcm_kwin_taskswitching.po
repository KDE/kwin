#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr ""
"L'arranjament de la política de focus limita la funcionalitat de navegar per "
"les finestres."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"El commutador de tasques alternatiu és un segon commutador amb la seva "
"pròpia configuració de drecera, aparença i comportament."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Vista general:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Llisqueu cap amunt amb quatre dits en un ratolí tàctil o tres en una "
"pantalla tàctil, o utilitzeu gestos de vora de la pantalla per commutar la "
"visió general"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Premeu %1, llisqueu cap amunt amb quatre dits en un ratolí tàctil o tres en "
"una pantalla tàctil, o utilitzeu gestos de vora de la pantalla per commutar "
"la visió general"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Premeu %1 o %2, llisqueu cap amunt amb quatre dits en un ratolí tàctil o "
"tres en una pantalla tàctil, o utilitzeu gestos de vora de la pantalla per "
"commutar la visió general"

