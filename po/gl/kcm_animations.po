#: ui/main.qml:95
#, fuzzy, kde-kuit-format
#| msgctxt "@info:tooltip"
#| msgid ""
#| "Some applications do not support this setting: In particular, GTK "
#| "applications cannot change animation duration, but will still disable "
#| "animations when <interface>animation speed</interface> is "
#| "<interface>Instant</interface>."
msgctxt "@info:tooltip"
msgid ""
"Some applications do not support this setting: in particular, GTK "
"applications cannot change animation duration, but will still disable "
"animations when <interface>animation speed</interface> is "
"<interface>Instant</interface>."
msgstr ""
"Algunhas aplicacións non son compatíbeis con esta opción: en concreto, as "
"aplicacións de GTK non poden cambiar a duración das animación, aínda que si "
"poden desactivar as animacións se a <interface>velocidade das animacións</"
"interface> é <interface>instantánea</interface>."

