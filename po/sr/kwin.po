#: core/iccprofile.cpp:402
#, kde-format
msgid "Failed to open ICC profile \"%1\""
msgstr "Не могу да отворим профил ИЦЦ „%1“"

#: core/iccprofile.cpp:404
#, kde-format
msgid "ICC profile \"%1\" doesn't exist"
msgstr "Профил ИЦЦ „%1“ не постоји"

#: core/iccprofile.cpp:408
#, kde-format
msgid "ICC profile \"%1\" is not usable for displays"
msgstr "Профил ИЦЦ „%1“ није употребљив за екране"

#: core/iccprofile.cpp:411
#, kde-format
msgid ""
"ICC profile \"%1\" has unsupported connection space, only XYZ is supported"
msgstr "Профил ИЦЦ „%1“ има неподржан простор везе, подржан је само XYZ"

#: core/iccprofile.cpp:414
#, kde-format
msgid "ICC profile \"%1\" is broken, input/output color space isn't RGB"
msgstr "Профил ИЦЦ „%1“ је покварен, улазни/излазни простор боја није РГБ"

#: core/iccprofile.cpp:427
#, kde-format
msgid "ICC profile \"%1\" is broken, it has no whitepoint"
msgstr "Профил ИЦЦ „%1“ је покварен, нема белу тачку"

#: core/iccprofile.cpp:430
#, kde-format
msgid "ICC profile \"%1\" is broken, its whitepoint is invalid"
msgstr "Профил ИЦЦ „%1“ је покварен, бела тачка му није исправна"

#: core/iccprofile.cpp:441
#, kde-format
msgid ""
"ICC profile \"%1\" is broken, parsing chromatic adaptation matrix failed"
msgstr ""
"Профил ИЦЦ „%1“ је покварен, рашчлањивање матрице хроматске адаптације није "
"успело"

#: core/iccprofile.cpp:446
#, kde-format
msgid ""
"ICC profile \"%1\" is broken, inverting chromatic adaptation matrix failed"
msgstr ""
"Профил ИЦЦ „%1“ је покварен, инвертовање матрице хроматске адаптације није "
"успело"

#: core/iccprofile.cpp:455 core/iccprofile.cpp:470 core/iccprofile.cpp:488
#, kde-format
msgid "ICC profile \"%1\" is broken, its primaries are invalid"
msgstr "Профил ИЦЦ „%1“ је покварен, основне боје му нису исправне"

#: core/iccprofile.cpp:463
#, kde-format
msgid "ICC profile \"%1\" is broken, it has no primaries"
msgstr "Профил ИЦЦ „%1“ је покварен, нема основне боје"

#: core/iccprofile.cpp:482
#, kde-format
msgid "ICC profile \"%1\" is broken, couldn't calculate its primaries"
msgstr "Профил ИЦЦ „%1“ је покварен, не могу да израчунам његове основне боје"

#: core/iccprofile.cpp:507
#, kde-format
msgid "ICC profile \"%1\" with only BToD tags isn't supported"
msgstr "Профил ИЦЦ „%1“ само са ознакама BToD није подржан"

#: core/iccprofile.cpp:545
#, kde-format
msgid "Color profile is missing TRC tags"
msgstr "Профилу боја недостају ознаке TRC"

#: core/iccprofile.cpp:552
#, kde-format
msgid "Couldn't invert tone curves of ICC profile \"%1\""
msgstr "Не могу да инвертујем тонске криве профила ИЦЦ „%1“"

