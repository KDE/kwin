#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr ""
"Fokusa politikas iestatījumi ierobežo pārvietošanās starp logiem "
"funkcionalitāti."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"Alternatīvs uzdevumu pārslēdzējs ir otrs pārslēdzējs ar savu atsevišķu "
"saīsni, izskatu un uzvedības iestatījumiem."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Pārskats:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Pavelciet augšup ar četriem pirkstiem skārienpaliktnī vai ar trim pirkstiem "
"skārienekrānā, vai lietojiet ekrāna malas žestu, lai ieietu pārskatā vai "
"izietu no tā"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Spiediet „%1“, pavelciet augšup ar četriem pirkstiem skārienpaliktnī vai ar "
"trim pirkstiem skārienekrānā, vai lietojiet ekrāna malas žestu, lai ieietu "
"pārskatā vai izietu no tā"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Spiediet „%1“vai „%2“, pavelciet augšup ar četriem pirkstiem skārienpaliktnī "
"vai ar trim pirkstiem skārienekrānā, vai lietojiet ekrāna malas žestu, lai "
"ieietu pārskatā vai izietu no tā"

