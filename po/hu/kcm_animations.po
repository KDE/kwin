#: ui/main.qml:95
#, fuzzy, kde-kuit-format
#| msgctxt "@info:tooltip"
#| msgid ""
#| "Some applications do not support this setting: In particular, GTK "
#| "applications cannot change animation duration, but will still disable "
#| "animations when <interface>animation speed</interface> is "
#| "<interface>Instant</interface>."
msgctxt "@info:tooltip"
msgid ""
"Some applications do not support this setting: in particular, GTK "
"applications cannot change animation duration, but will still disable "
"animations when <interface>animation speed</interface> is "
"<interface>Instant</interface>."
msgstr ""
"Egyes alkalmazások nem támogatják ezt a beállítást: különösen a GTK "
"alkalmazások nem tudják megváltoztatni az animáció időtartamát, de akkor is "
"letiltják az animációkat, ha az <interface>animációsebesség</interface> "
"értéke <interface>Azonnali</interface>."

