#: ui/Focus.qml:22
#, kde-format
msgctxt "@label:listbox"
msgid "Window focus policy:"
msgstr "Smjernice fokusiranja prozora:"

#: ui/Focus.qml:46
#, kde-format
msgctxt "@item:inlistbox Window focus policy"
msgid "Click to focus"
msgstr "fokus na klik"

#: ui/Focus.qml:47
#, kde-format
msgctxt "@info:tooltip Window focus policy"
msgid "Window becomes focused when clicked."
msgstr "Prozor dobija fokus kad se na njega klikne."

#: ui/Focus.qml:51
#, kde-format
msgctxt "@item:inlistbox Window focus policy"
msgid "Focus follows pointer"
msgstr "fokus prati pokazivač"

#: ui/Focus.qml:52
#, kde-format
msgctxt "@info:tooltip Window focus policy"
msgid ""
"As the pointer moves, windows under it become focused after a configurable "
"delay."
msgstr ""
"Dok se pokazivač pomijera, prozori ispod njega dobijaju fokus poslije "
"zadatog kašnjenja."

#: ui/Focus.qml:56
#, kde-format
msgctxt "@item:inlistbox Window focus policy"
msgid "Focus under pointer"
msgstr "fokus pod pokazivačem"

#: ui/Focus.qml:57
#, kde-format
msgctxt "@info:tooltip Window focus policy"
msgid "Window under pointer receives focus, even if the pointer has not moved."
msgstr ""
"Prozor pod pokazivačem dobija fokus, čak i ako se pokazivač nije pomjerio."

#: ui/Focus.qml:75
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Selecting <interface>Focus under pointer</interface> will prevent focus on "
"some windows appearing on screen. This can lead to assigning focus to "
"unwanted windows. Use with caution."
msgstr ""
"Izbor <interface>fokus pod pokazivačem</interface> spriječiće fokus na nekim "
"prozorima koji se pojavljuju na ekranu. To može dovesti do davanja fokusa "
"neželjenim prozorima. Koristite oprezno."

#: ui/Focus.qml:81
#, kde-format
msgctxt "@option:radio After closing a window, move focus to:"
msgid "Last focused window"
msgstr "Posljednji fokusirani prozor"

