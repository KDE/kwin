msgid "Overview"
msgstr "Pregled"

#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr ""
"Postavke smjernice fokusiranja ograničavaju funkcionalnost kretanja između "
"prozora."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"Alternativni mjenjač zadataka je drugi mjenjač, sa sopstvenom prečicom i "
"sopstvenim postavkama izgleda i ponašanja."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Pregled:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Prevucite nagore sa četiri prsta po dodirniku ili sa tri po ekranu na dodir, "
"ili upotrijebite gestove ivica ekrana, da biste uključili ili isključili "
"pregled"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Pritisnite %1, prevucite nagore sa četiri prsta po dodirniku ili sa tri po "
"ekranu na dodir, ili upotrijebite gestove ivica ekrana, da biste uključili "
"ili isključili pregled"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Pritisnite %1 ili %2, prevucite nagore sa četiri prsta po dodirniku ili sa "
"tri po ekranu na dodir, ili upotrijebite gestove ivica ekrana, da biste "
"uključili ili isključili pregled"

#: ui/OverviewSettings.qml:31
#, kde-format
msgctxt "@option:check, Enable overview effect"
msgid "Enable"
msgstr "Uključi"

