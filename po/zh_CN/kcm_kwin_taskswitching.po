msgid "Show delay:"
msgstr "显示延迟："

#: ui/TabBoxSettings.qml:122
#, kde-format
msgctxt "@info"
msgid ""
"Time to wait before showing the task switcher. Also applies to the "
"alternative task switcher."
msgstr "显示任务切换器前需要等待的时间。也适用于第二任务切换器。"

#: ui/TabBoxSettings.qml:141
#, kde-format
