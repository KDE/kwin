#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr ""
"A configurações da política de foco limita a funcionalidade da navegação "
"pelas janelas."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"O seletor de tarefas alternativo é um segundo alternador que possui seu "
"próprio atalho, aparência e configurações de comportamento, independentes "
"dos demais."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Visão geral:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Deslize para cima com quatro dedos em um touchpad ou com três dedos em uma "
"tela sensível ao toque, ou utilize gestos a partir das bordas da tela para "
"alternar a visão geral"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Pressione %1, deslize para cima com quatro dedos em um touchpad ou com três "
"dedos em uma tela sensível ao toque, ou utilize gestos a partir das bordas "
"da tela para alternar a visão geral"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Pressione %1 ou %2, deslize para cima com quatro dedos em um touchpad ou com "
"três dedos em uma tela sensível ao toque, ou utilize gestos a partir das "
"bordas da tela para alternar a visão geral"

#: ui/OverviewSettings.qml:31
#, kde-format
msgctxt "@option:check, Enable overview effect"
msgid "Enable"
msgstr "Habilitar"

