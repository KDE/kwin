#: ui/main.qml:62
#, kde-format
msgctxt "@info"
msgid ""
"Focus policy settings limit the functionality of navigating through windows."
msgstr ""
"Las preferencias de políticas de foco limitan la funcionalidad de la "
"navegación entre ventanas."

#: ui/main.qml:102
#, kde-format
msgctxt "@info"
msgid ""
"The alternative task switcher is a second switcher with its own separate "
"shortcut, appearance, and behavior settings."
msgstr ""
"El selector de tareas alternativo es un segundo selector con sus propias "
"preferencias de atajo de teclado, aspecto y comportamiento."

#: ui/OverviewSettings.qml:20
#, kde-format
msgctxt "@label"
msgid "Overview:"
msgstr "Vista general:"

#: ui/OverviewSettings.qml:23
#, kde-format
msgctxt "@label Hint for overview effect enable button"
msgid ""
"Swipe up with four fingers on a touchpad or three on a touchscreen, or use "
"screen edge gestures to toggle the overview"
msgstr ""
"Deslice hacia arriba con cuatro dedos en el panel táctil (o con tres en la "
"pantalla táctil) o use los gestos de los bordes de la pantalla para cambiar "
"a la vista general"

#: ui/OverviewSettings.qml:25
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 is a keyboard shortcut"
msgid ""
"Press %1, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Pulse %1, deslice hacia arriba con cuatro dedos en el panel táctil (o con "
"tres en la pantalla táctil) o use los gestos de los bordes de la pantalla "
"para cambiar a la vista general"

#: ui/OverviewSettings.qml:27
#, kde-format
msgctxt ""
"@label Hint for overview effect enable button, %1 and %2 are alternative "
"keyboard shortcuts"
msgid ""
"Press %1 or %2, swipe up with four fingers on a touchpad or three on a "
"touchscreen, or use screen edge gestures to toggle the overview"
msgstr ""
"Pulse %1 o %2, deslice hacia arriba con cuatro dedos en el panel táctil (o "
"con tres en la pantalla táctil) o use los gestos de los bordes de la "
"pantalla para cambiar a la vista general"

#: ui/OverviewSettings.qml:31
#, kde-format
msgctxt "@option:check, Enable overview effect"
msgid "Enable"
msgstr "Activar"

